# Backend settings. Copy this file to .env in the same backend folder.
PORT=8080
MONGODB_URI=mongodb://localhost:27017/aerosaga
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aerosaga-missions

# Docker Compose host ports (used by docker compose --env-file backend/.env)
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_PORT=27017
TEMPORAL_BIND_ADDRESS=127.0.0.1
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=18233
